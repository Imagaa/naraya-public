APP_NAME=Naraya
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://naraya.test:8080

APP_DOMAIN=naraya.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=naraya
DB_USERNAME=naraya
DB_PASSWORD=secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.naraya.test

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
# Livewire file uploads default to a direct-to-disk presigned PUT when the
# default disk is S3, which the browser sends straight to AWS_ENDPOINT — the
# same internal-only host that breaks reads (see the comment below), except
# this one has no public counterpart to swap in. Force the temp upload
# through the app server on local disk instead; the final ->store($path,
# 's3') call still goes to Garage, just server-to-server, not browser-to-server.
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Values below are placeholders — use the garage CLI to bootstrap
# a real bucket/key pair, then replace AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/
# AWS_BUCKET with the ones it prints. AWS_URL must point at the [s3_web]
# listener (see garage.toml), not AWS_ENDPOINT — that's the internal API
# endpoint the app uses to upload; browsers can't read objects through it
# (Garage has no anonymous access on the plain S3 API).
AWS_ACCESS_KEY_ID=naraya-dev
AWS_SECRET_ACCESS_KEY=naraya-dev-secret
AWS_DEFAULT_REGION=garage
AWS_BUCKET=naraya-media
AWS_ENDPOINT=http://garage:3900
AWS_URL=http://naraya-media.127.0.0.1.nip.io:3902
AWS_USE_PATH_STYLE_ENDPOINT=true

# Generate with: openssl rand -hex 32 — never commit the real value.
GARAGE_RPC_SECRET=

MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Free at https://openrouteservice.org/dev/#/signup — used for the driving
# route line on the sales delivery map. If unset, the route falls back to a
# straight line between origin and destination instead of following roads.
OPENROUTESERVICE_API_KEY=

VITE_APP_NAME="${APP_NAME}"
VAPID_SUBJECT=https://sales.example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
